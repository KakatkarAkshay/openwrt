# Router build configuration for the GL.iNet Flint 3 (GL-BE9300)
#
# The package selection below is what OpenWrt ships in an official release
# image, taken verbatim from the CONFIG_PACKAGE_* lines of
# https://downloads.openwrt.org/releases/25.12.5/targets/qualcommax/ipq807x/config.buildinfo
# qualcommbe has no release build yet, so a released target supplies the
# reference; every package in it is target independent.
#
# None of this arrives on its own. LuCI is absent from DEFAULT_PACKAGES in
# include/target.mk because that list also applies to 4 MB-flash targets, so
# official images pick it up from the buildbot's per-branch config_seed
# instead. Snapshot builds use a different seed and ship no web interface,
# which is why a plain `make defconfig` on this tree produces an image with
# no LuCI at all.
#
# Usage:
#   cp configs/router.config .config && make defconfig && make -j$(nproc)
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_glinet_gl-be9300=y

# --- signed apk package feed
# The signing key must stay the one already trusted by flashed units: a fresh
# key breaks package installs on every device in the field.
CONFIG_USE_APK=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_PER_FEED_REPO=y

# --- Site-to-Site VPN and BGP
CONFIG_PACKAGE_kmod-ipsec=y
CONFIG_PACKAGE_xfrm=y
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-default=y
CONFIG_PACKAGE_strongswan-mod-openssl=y
CONFIG_PACKAGE_frr=y
CONFIG_PACKAGE_frr-bgpd=y

# --- Tailscale VPN
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-tun=y

# --- LuCI web interface
# luci is the collection that pulls luci-light and luci-app-package-manager;
# luci-ssl adds the HTTPS listener. The parts they depend on are named
# explicitly so the set survives a collection changing its dependencies.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-lib-uqr=y

# --- LuCI applications
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y

# --- web server and rpc backend
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_liblucihttp=y
CONFIG_PACKAGE_liblucihttp-ucode=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_ucode-mod-html=y
CONFIG_PACKAGE_ucode-mod-log=y
CONFIG_PACKAGE_ucode-mod-math=y
CONFIG_PACKAGE_ucode-mod-uclient=y

# --- https certificate
# uhttpd self-signs on first boot; mbedtls to match libustream-mbedtls from
# DEFAULT_PACKAGES rather than pulling a second TLS stack into the image.
CONFIG_PACKAGE_px5g-mbedtls=y

# --- attended sysupgrade
# Kept for parity with release images, but both need a sysupgrade server that
# builds this target. The public one does not know gl-be9300, so the LuCI page
# and owut only work against a self-hosted ASU instance.
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_owut=y
