#!/bin/sh
#
# GL.iNet boards store the factory regulatory domain as a 2-byte ISO-3166
# country code in the ART partition. The vendor firmware exposes it as
# /proc/gl-hw-info/country_code via an out-of-tree module; read it straight
# out of the partition instead.
#
# Without a country set, hostapd refuses to start on 6 GHz ("Invalid
# country_code '00'"), so the radios stay down on a fresh install.

. /lib/functions.sh
. /lib/functions/system.sh

board=$(board_name)

case "$board" in
gl.inet,gl-be9300) ;;
*) exit 0 ;;
esac

art=$(find_mmc_part "0:ART")
[ -n "$art" ] || exit 0

# Offset 0x88, 2 bytes. Anything that is not two upper-case letters means
# the field is unprogrammed - leave the radios at the driver default then.
country=$(dd if="$art" bs=1 skip=136 count=2 2>/dev/null | tr -dc 'A-Z')
[ "${#country}" = 2 ] || exit 0

[ -f /etc/config/wireless ] || /sbin/wifi config

# A country counts as set only if it is two letters. `wifi config` writes
# country='00' for the 6 GHz radio whenever the board supplies no wlan defaults
# (see mac80211.uc), and '00' is worse than an unset value: hostapd rejects it
# with "Invalid country_code '00'" and then NO interface on the phy starts, not
# just 6 GHz. A non-empty test would skip precisely that radio and leave the
# board with no working Wi-Fi at all - which is the dead-radio report.
country_is_set() {
	[ "${#1}" = 2 ] || return 1
	case "$1" in
		*[!A-Z]*) return 1 ;;
	esac
	return 0
}

changed=0
for dev in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
	cur=$(uci -q get wireless.$dev.country | tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z')
	country_is_set "$cur" && continue
	uci set wireless.$dev.country="$country"
	changed=1
done

[ "$changed" = 1 ] && uci commit wireless

exit 0
