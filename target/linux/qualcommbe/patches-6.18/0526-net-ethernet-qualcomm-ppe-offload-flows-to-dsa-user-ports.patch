From: Akshay Kakatkar <me@kakatkarakshay.dev>
Date: Wed, 29 Jul 2026 00:00:00 +0530
Subject: [PATCH] net: ethernet: qualcomm: ppe: offload flows through DSA user ports

A flow whose ingress or egress device is a DSA user port behind a PPE
conduit (the RTL8372N switch on IPQ5332 boards) was rejected, leaving
routed and NAT'd traffic involving wired LAN clients on the software
path while the same traffic involving a wireless client already
offloads through virtual ports.

With a tag_8021q tagger the switch needs no header the PPE cannot
produce: forward the flow through the conduit's PPE port and let the
next hop push the user port's standalone VID, which the switch decodes
for precise delivery and strips on egress, exactly as the tagger's own
xmit path does. The egress L3 interface is the conduit port's, so the
source-MAC rewrite and MY_MAC entry land where the reverse direction
ingresses.

Resolve ingress from a DSA user port to the conduit and classify its
standalone VID through the existing VLAN-uplink machinery. This makes
the hardware lookup key match packets before the DSA receive path
removes the tag. Keep a reference to a DSA egress netdev so its carrier,
rather than only the conduit's, controls flow activity reporting.

Ports under a proprietary tagger stay rejected, as do DSA flows that
already carry a user VLAN: the hardware path exposed by this driver has
only one VLAN slot and cannot represent both the tag_8021q tag and a
user tag.

Signed-off-by: Akshay Kakatkar <me@kakatkarakshay.dev>
---
--- a/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
+++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flowtable.c
@@ -16,6 +16,7 @@
 
 #include <linux/atomic.h>
 #include <linux/debugfs.h>
+#include <linux/dsa/8021q.h>
 #include <linux/etherdevice.h>
 #include <linux/hashtable.h>
 #include <linux/if_arp.h>
@@ -161,5 +162,6 @@
  * @vlan: VLAN uplink slot held by the flow, negative when none.
  * @eport: Egress PPE port of the flow.
+ * @egress_dev: DSA user netdev held for carrier checks.
  * @packets: Hit packet count at the last stats read.
  * @bytes: Hit byte count at the last stats read.
  */
@@ -182,6 +184,7 @@ struct ppe_ft_flow {
 	int ivp;
 	struct ppe_vp_flow vp_flow;
 	u8 eport;
+	struct net_device *egress_dev;
 	u32 packets;
 	u64 bytes;
 };
@@ -1776,6 +1777,30 @@
 			flow->index, ret);
 
 	list_add_tail(&flow->zombie_node, &ft->zombies);
+}
+
+/* A DSA user port behind a PPE conduit is reachable only with a
+ * tag_8021q tagger whose standalone VID the PPE can match or push.
+ * A proprietary tagger's header is not something the PPE can handle.
+ */
+static struct dsa_port *ppe_ft_dsa_port(struct net_device *dev)
+{
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return NULL;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp))
+		return NULL;
+
+	if (dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_VSC73XX_8021Q)
+		return NULL;
+
+	if (!edma_port_dev_check(dsa_port_to_conduit(dp)))
+		return NULL;
+
+	return dp;
 }
 
 static int ppe_ft_flow_replace(struct ppe_flowtable *ft,
@@ -2147,6 +2171,7 @@
 	}
 	reject_reason = PPE_FT_REJECT_OUTPUT_DEVICE;
 	if (!tunnel_encap && !edma_port_dev_check(odev) &&
+	    !ppe_ft_dsa_port(odev) &&
 	    (!ft->ppe_dev->variant->has_vports ||
 	     odev->type != ARPHRD_ETHER || !odev->ieee80211_ptr)) {
 		ret = -EOPNOTSUPP;
@@ -2194,6 +2221,7 @@
 	 */
 	if (data.ingress_ifindex) {
 		struct net_device *idev;
+		struct dsa_port *dp;
 		struct net_device *master;
 		int vp_ret = 0;
 
@@ -2219,5 +2247,23 @@
 
 			iport = ipriv->ppe_port->port_id;
+		} else if (ppe_ft_dsa_port(idev)) {
+			struct net_device *conduit;
+			struct edma_port_priv *ipriv;
+
+			dp = ppe_ft_dsa_port(idev);
+			conduit = dsa_port_to_conduit(dp);
+
+			/* The parser exposes one VLAN layer. A user VLAN inside
+			 * the tag_8021q tag cannot use this path.
+			 */
+			if (data.ingress_vid >= 0) {
+				vp_ret = -EOPNOTSUPP;
+				goto put_idev;
+			}
+
+			ipriv = netdev_priv(conduit);
+			iport = ipriv->ppe_port->port_id;
+			data.ingress_vid = dsa_tag_8021q_standalone_vid(dp);
 		} else if (ft->ppe_dev->variant->has_vports &&
 			   idev->type == ARPHRD_ETHER && idev->ieee80211_ptr) {
 			reject_reason = PPE_FT_REJECT_INGRESS_VP;
@@ -2226,6 +2269,7 @@
 			if (vp_ret >= 0)
 				flow->ivp = vp_ret;
 		}
+put_idev:
 		dev_put(idev);
 
 		if (vp_ret < 0) {
@@ -2220,6 +2245,23 @@
 			port_priv = netdev_priv(odev);
 			nh.port = port_priv->ppe_port->port_id;
 			nh.l3_if = nh.port;
+		} else if (ppe_ft_dsa_port(odev)) {
+			struct dsa_port *dp = ppe_ft_dsa_port(odev);
+
+			/* The next hop pushes one tag; a switch port
+			 * with tagged bridge-vlan egress would need
+			 * its 802.1Q tag inside the tag_8021q one.
+			 */
+			if (nh.vid >= 0) {
+				ret = -EOPNOTSUPP;
+				goto err_prelock_ivp;
+			}
+			port_priv = netdev_priv(dsa_port_to_conduit(dp));
+			nh.port = port_priv->ppe_port->port_id;
+			nh.l3_if = nh.port;
+			nh.vid = dsa_tag_8021q_standalone_vid(dp);
+			flow->egress_dev = odev;
+			dev_hold(flow->egress_dev);
 		} else {
 			ret = ppe_vp_get(ft->ppe_dev, odev,
 					 f->common.prio);
@@ -2572,6 +2614,8 @@
 err_free:
 	if (ret)
 		atomic_long_inc(&ft->rejects[reject_reason]);
+	if (flow && flow->egress_dev)
+		dev_put(flow->egress_dev);
 	kfree_rcu(flow, rcu);
 
 	return ret;
@@ -2608,6 +2652,8 @@ static int ppe_ft_flow_destroy(struct pp
 		ppe_ft_tunnel_put(ft, flow->tunnel);
 		ppe_vp_put(ft->ppe_dev, flow->vp);
 		ppe_vp_put(ft->ppe_dev, flow->ivp);
+		if (flow->egress_dev)
+			dev_put(flow->egress_dev);
 	} else {
 		ppe_ft_flow_quarantine(ft, flow);
 		flow = NULL;
@@ -2681,6 +2726,11 @@ static int ppe_ft_flow_stats(struct ppe_
 		return -ENOENT;
 	}
 
+	if (flow->egress_dev && !netif_carrier_ok(flow->egress_dev)) {
+		rcu_read_unlock();
+		return 0;
+	}
+
 	/* Hardware-forwarded packets never revalidate the route in
 	 * software, and the hit counter of a flow counts at ingress
 	 * lookup whether or not egress delivery still works: a flow
@@ -3481,9 +3531,16 @@ int ppe_flowtable_setup(struct ppe_devic
 	rtnl_unlock();
 
 	return 0;
 }
 
+static void ppe_ft_flow_release(struct ppe_ft_flow *flow)
+{
+	if (flow->egress_dev)
+		dev_put(flow->egress_dev);
+	kfree(flow);
+}
+
 static void ppe_ft_flow_free(void *ptr, void *arg)
 {
-	kfree(ptr);
+	ppe_ft_flow_release(ptr);
 }
@@ -3482,5 +3494,5 @@ void ppe_flowtable_destroy(struct ppe_de
 	rhashtable_free_and_destroy(&ft->flows, ppe_ft_flow_free, NULL);
 	list_for_each_entry_safe(flow, flow_tmp, &ft->zombies, zombie_node) {
 		list_del(&flow->zombie_node);
-		kfree(flow);
+		ppe_ft_flow_release(flow);
 	}
