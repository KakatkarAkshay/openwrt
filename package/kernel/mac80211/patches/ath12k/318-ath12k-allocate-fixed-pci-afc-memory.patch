From: Balamurugan Ramar <bramar@qti.qualcomm.com>
Date: Tue, 3 Jun 2025 06:16:22 +0530
Subject: [PATCH] wifi: ath12k: allocate shared memory for AFC payload

Allocate and assign a shared memory chunk for storing the AFC payload.
The host writes the AFC payload to this memory and notifies firmware to
read it.

QCN9274 firmware requests this region even when the PCI target-memory
path uses reserved host DDR. Allocate it separately as coherent DMA,
matching Qualcomm's PCI implementation, and handle its distinct cleanup.

Adapted from Qualcomm's downstream AFC shared-memory support by Amith A,
Hariharan Basuthkar and Balamurugan Ramar.

Link: https://github.com/Telecominfraproject/wlan-ap/blob/4dda11dcf7455828e03a753079c520701f2f7a7c/feeds/qca-wifi-7/mac80211/patches-qca/ath12k/0346-01-wifi-ath12k-Allocate-shared-memory-for-AFC-payload.patch
Signed-off-by: Amith A <quic_amitajit@quicinc.com>
Signed-off-by: Hariharan Basuthkar <quic_hbasuthk@quicinc.com>
Signed-off-by: Balamurugan Ramar <bramar@qti.qualcomm.com>
Signed-off-by: Akshay Kakatkar <me@kakatkarakshay.dev>
---
 drivers/net/wireless/ath/ath12k/coredump.c |  3 +++
 drivers/net/wireless/ath/ath12k/coredump.h |  1 +
 drivers/net/wireless/ath/ath12k/qmi.c      | 22 +++++++++++++++++++++-
 drivers/net/wireless/ath/ath12k/qmi.h      |  4 ++++
 4 files changed, 29 insertions(+), 1 deletion(-)

--- a/drivers/net/wireless/ath/ath12k/coredump.c
+++ b/drivers/net/wireless/ath/ath12k/coredump.c
@@ -30,6 +30,9 @@ ath12k_fw_crash_dump_type ath12k_coredum
 	case MLO_GLOBAL_MEM_REGION_TYPE:
 		dump_type = FW_CRASH_DUMP_MLO_GLOBAL_DATA;
 		break;
+	case AFC_REGION_TYPE:
+		dump_type = FW_CRASH_DUMP_AFC_DATA;
+		break;
 	default:
 		dump_type = FW_CRASH_DUMP_TYPE_MAX;
 		break;
--- a/drivers/net/wireless/ath/ath12k/coredump.h
+++ b/drivers/net/wireless/ath/ath12k/coredump.h
@@ -16,6 +16,7 @@ enum ath12k_fw_crash_dump_type {
 	FW_CRASH_DUMP_M3_DUMP,
 	FW_CRASH_DUMP_NONE,
 	FW_CRASH_DUMP_MLO_GLOBAL_DATA,
+	FW_CRASH_DUMP_AFC_DATA,
 
 	/* keep last */
 	FW_CRASH_DUMP_TYPE_MAX,
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2561,7 +2561,14 @@ static void ath12k_qmi_free_target_mem_c
 							      mlo_idx);
 			mlo_idx++;
 		} else {
-			if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags) &&
+			if (ab->qmi.target_mem[i].type == AFC_REGION_TYPE &&
+			    ab->qmi.target_mem[i].v.addr) {
+				dma_free_coherent(ab->dev,
+						  ab->qmi.target_mem[i].prev_size,
+						  ab->qmi.target_mem[i].v.addr,
+						  ab->qmi.target_mem[i].paddr);
+				ab->qmi.target_mem[i].v.addr = NULL;
+			} else if (test_bit(ATH12K_FLAG_FIXED_MEM_REGION, &ab->dev_flags) &&
 			    ab->qmi.target_mem[i].v.ioaddr) {
 				iounmap(ab->qmi.target_mem[i].v.ioaddr);
 				ab->qmi.target_mem[i].v.ioaddr = NULL;
@@ -2866,6 +2873,19 @@ static int ath12k_qmi_assign_pci_target_
 		chunk = &ab->qmi.target_mem[i];
 
 		switch (chunk->type) {
+		case AFC_REGION_TYPE:
+			if (chunk->size > AFC_MEM_SIZE) {
+				ath12k_warn(ab,
+					    "AFC memory request size %u exceeds %u\n",
+					    chunk->size, AFC_MEM_SIZE);
+				ret = -EINVAL;
+				goto out;
+			}
+
+			ret = ath12k_qmi_alloc_chunk(ab, chunk);
+			if (ret)
+				goto out;
+			break;
 		case HOST_DDR_REGION_TYPE:
 		case CALDB_MEM_REGION_TYPE:
 		case PAGEABLE_MEM_REGION_TYPE:
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -168,6 +168,9 @@
 #define QMI_WLANFW_MAX_PLATFORM_NAME_LEN_V01		64
 #define QMI_WLANFW_MAX_HOST_DDR_RANGE_SIZE_V01		3
 
+#define AFC_SLOT_SIZE					0x1000
+#define AFC_MAX_SLOT					2
+#define AFC_MEM_SIZE					(AFC_SLOT_SIZE * AFC_MAX_SLOT)
 struct qmi_wlanfw_host_ddr_range {
 	u64 start;
 	u64 size;
@@ -178,6 +181,7 @@ enum ath12k_qmi_target_mem {
 	CALDB_MEM_REGION_TYPE = 0x4,
 	MLO_GLOBAL_MEM_REGION_TYPE = 0x8,
 	PAGEABLE_MEM_REGION_TYPE = 0x9,
+	AFC_REGION_TYPE = 0xa,
 	LPASS_SHARED_V01_REGION_TYPE = 0xb,
 };
 
